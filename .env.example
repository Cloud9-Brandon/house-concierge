# Course key (preferred): uses gpt-6-luna through Portkey
PORTKEY_API_KEY=your-portkey-key-here

# Or your own OpenAI key (uses gpt-4o-mini unless OPENAI_MODEL is set)
OPENAI_API_KEY=sk-your-key-here

# Optional: email notifications for pro requests (without these, requests are logged to the server console)
RESEND_API_KEY=re_your-key-here
NOTIFY_EMAIL=you@example.com

# Optional: global cap on chat requests per day (default 1000)
DAILY_REQUEST_CAP=1000
